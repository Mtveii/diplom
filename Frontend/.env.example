# Копировать в .env.local и заполнить. НЕ коммитить .env.local
# API через same-origin proxy (vite/nginx/vercel rewrites) — VITE_API_BASE_URL не нужен.
# Для альтернативного бэкенда: VITE_API_BASE_URL=https://your-api.example.com

# Только для локальной разработки — не используется в прод-сборке.
